# Local Docker database identity. The password is mounted from a Docker secret.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=pax_dev
DATABASE_USER=pax_app
DATABASE_PASSWORD_FILE=/run/secrets/pax_postgres_password

# Authentication. NEXTAUTH_URL is injected by the deployment environment.
NEXTAUTH_SECRET_FILE=/run/secrets/pax_nextauth_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Analytics and abuse protection.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform notification and moderation services.
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_CONTACT_FORM_SUBMISSION=
NOTIF_ID_SAFETY_REPORT_ACKNOWLEDGEMENT=
NOTIF_ID_DEVELOPMENT_UPDATE=

# Object storage and malware scanning.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_GUARDDUTY_MALWARE_PROTECTION=
UPLOAD_SCAN_WEBHOOK_SECRET=

# Payments. Keep sandbox values in local and staging environments.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=
MPESA_CALLBACK_SECRET=

# Product feature flags.
BRIEF_PILOT_FREE=true

# Talent and trusted product hosts. Enable only after additive migrations and Talent foundations.
TALENT_ENABLED=false
PAX_PRODUCT_ROUTING_ENABLED=false
PAX_ROOT_DOMAIN=domanname.com
# The deployment platform must inject the accounts origin into NextAuth configuration.
# All four HTTPS hosts must point to this application. Do not host untrusted content on these subdomains.
NOTIF_ID_TALENT_ACTIVITY=
NOTIF_ID_TALENT_TEAM_INVITATION=

# Expanded practitioner workspace: enable only after the migration rehearsal and acceptance checks.
PRACTICE_WORKSPACE_ENABLED=false
# Register these provider templates before enabling their email delivery.
NOTIF_ID_PRACTICE_INVITATION=
NOTIF_ID_PRACTICE_BOOKING_VERIFICATION=
NOTIF_ID_PRACTICE_BOOKING_UPDATE=
NOTIF_ID_PRACTICE_APPOINTMENT_REMINDER=
NOTIF_ID_PRACTICE_BALANCE_REMINDER=

# Optional: native-https uses installed curl with TLS verification; default uses Node fetch.
PRACTICE_REGISTRY_TRANSPORT=node
