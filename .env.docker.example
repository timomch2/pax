# Local Docker database identity. The password is mounted from a Docker secret.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=pax_dev
DATABASE_USER=pax_app
DATABASE_PASSWORD_FILE=/run/secrets/pax_postgres_password

# Authentication. NEXTAUTH_URL is injected by the deployment environment.
NEXTAUTH_SECRET_FILE=/run/secrets/pax_nextauth_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Analytics and abuse protection.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform notification and moderation services.
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_CONTACT_FORM_SUBMISSION=
NOTIF_ID_SAFETY_REPORT_ACKNOWLEDGEMENT=
NOTIF_ID_DEVELOPMENT_UPDATE=

# Object storage and malware scanning.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_GUARDDUTY_MALWARE_PROTECTION=
UPLOAD_SCAN_WEBHOOK_SECRET=

# Payments. Keep sandbox values in local and staging environments.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=
MPESA_CALLBACK_SECRET=

# Product feature flags.
BRIEF_PILOT_FREE=true
