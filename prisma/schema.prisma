generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PRACTITIONER
  PATIENT
  ADMIN
  INNOVATOR
  INVESTOR
  EMPLOYER
  POLICYMAKER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccessScope {
  OWN
  ORGANIZATION
  ALL
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ClinicalRelationshipStatus {
  ACTIVE
  ENDED
  REVOKED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_CHALLENGE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  DEAD_LETTER
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  DEAD_LETTER
  SKIPPED
}

enum UploadPurpose {
  PROFILE_IMAGE
  GPS_EVIDENCE
  INNOVATION_EVIDENCE
  VAULT_DOCUMENT
  VERIFICATION_DOCUMENT
  VENDOR_DOCUMENT
  SAFETY_ATTACHMENT
  TALENT_RESUME
}

enum UploadStatus {
  PENDING_UPLOAD
  UPLOADED
  QUARANTINED
  SCANNING
  CLEAN
  REJECTED
  EXPIRED
}

enum PaymentProvider {
  PAYSTACK
  MPESA
  MANUAL
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PaymentIntentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReconciliationStatus {
  MATCHED
  MISMATCHED
  MISSING_INTERNAL
  MISSING_PROVIDER
  RESOLVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANCY
  INTERNSHIP
  VOLUNTEER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  OBJECTION
  RESTRICTION
  PORTABILITY
  CONSENT_WITHDRAWAL
}

enum DataSubjectRequestStatus {
  RECEIVED
  ACKNOWLEDGED
  IN_REVIEW
  WAITING_USER
  PARTIALLY_COMPLETED
  COMPLETED
  REJECTED
}

enum RetentionAction {
  DELETE
  DEIDENTIFY
  ARCHIVE
  REVIEW
}

enum SecurityIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityIncidentStatus {
  OPEN
  CONTAINED
  INVESTIGATING
  REMEDIATED
  CLOSED
}

enum OperationalJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// Membership tier = access level, separate from user type (role).
// Tier 1 Basic (free), Tier 2 Professional, Tier 3 Expert.
enum MembershipTier {
  TIER1_BASIC
  TIER2_PROFESSIONAL
  TIER3_EXPERT
}

enum VerificationLevel {
  NONE
  EMAIL_VERIFIED
  IDENTITY_VERIFIED
  EXPERT_VERIFIED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InnovationStage {
  IDEA
  PROTOTYPE
  PILOT
  SCALING
}

enum InnovationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  COMMUNITY_VALIDATED
  INVESTOR_READY
  FUNDED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  RELEASED
}

enum InvestmentStatus {
  INTERESTED
  DUE_DILIGENCE
  COMMITTED
  DISBURSING
  COMPLETED
  DECLINED
}

enum CashFlowType {
  INFLOW
  OUTFLOW
}

enum DiligenceStatus {
  PENDING
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  BILLING
  INVESTMENT
  MILESTONE
  APPOINTMENT
}

enum AppointmentType {
  CONSULTATION
  REVIEW
  WARD_ROUND
  THEATRE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PayerType {
  PATIENT
  INSURER
  EMPLOYER
  SHA_NHIF
  NGO_DONOR
  OTHER
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK_TRANSFER
  INSURANCE
  CHEQUE
  OTHER
}

enum InsurerCategory {
  PUBLIC
  PRIVATE
  CORPORATE
  NGO_DONOR
  OTHER
}

enum ReminderChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  email                String            @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  role                 UserRole          @default(PATIENT)
  additionalRoles      String[]          @default([])
  tier                 MembershipTier    @default(TIER1_BASIC)
  phone                String?
  paxId                String?           @unique
  organization         String?
  bio                  String?
  linkedinUrl          String?
  headline             String?
  location             String?
  physicalAddress      String?           @db.Text
  city                 String?
  postalCode           String?
  country              String?
  healthAreas          String?           @db.Text
  credibilityScore     Int               @default(0)
  verificationLevel    VerificationLevel @default(NONE)
  hubMember            Boolean           @default(false)
  hubJoinedAt          DateTime?
  consentedAt          DateTime?
  privacyPolicyVersion String?
  termsVersion         String?
  mfaEnabled           Boolean           @default(false)
  mfaSecret            String?
  mfaRecoveryCodes     String[]          @default([])
  failedLoginCount     Int               @default(0)
  lockedUntil          DateTime?
  accountStatus        AccountStatus     @default(ACTIVE)
  permissionVersion    Int               @default(1)
  sessionVersion       Int               @default(1)
  isSuperAdmin         Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts                            Account[]
  sessions                            Session[]
  practitionerProfile                 PractitionerProfile?
  appointmentsAsPatient               Appointment[]               @relation("PatientAppointments")
  appointmentsAsPractitioner          Appointment[]               @relation("PractitionerAppointments")
  patientNotes                        PatientNote[]               @relation("PatientNotePatient")
  authoredNotes                       PatientNote[]               @relation("PatientNoteAuthor")
  innovations                         Innovation[]                @relation("InnovationOwner")
  investments                         Investment[]                @relation("InvestorInvestments")
  endorsements                        Endorsement[]               @relation("UserEndorsements")
  notifications                       Notification[]              @relation("UserNotifications")
  ledgerEntries                       LedgerEntry[]               @relation("UserLedger")
  drugReports                         AdverseDrugReport[]         @relation("UserDrugReports")
  productFeedback                     ProductFeedback[]           @relation("UserProductFeedback")
  gpsEntries                          GpsEntry[]                  @relation("UserGpsEntries")
  gpsEndorsementsGiven                GpsEndorsement[]            @relation("GpsEndorser")
  challengeBriefs                     ChallengeBrief[]            @relation("UserChallengeBriefs")
  challengeResponses                  ChallengeResponse[]         @relation("UserChallengeResponses")
  vaultAccessRequests                 VaultAccessRequest[]        @relation("VaultRequester")
  debatesInitiated                    Debate[]                    @relation("DebateInitiator")
  debatesAsDevil                      Debate[]                    @relation("DebateDevilsAdvocate")
  debateContributions                 DebateContribution[]        @relation("DebateContributionAuthor")
  debateStances                       DebateStance[]              @relation("UserDebateStances")
  contributionUpvotes                 ContributionUpvote[]        @relation("UserContributionUpvotes")
  marketplaceVendor                   MarketplaceVendor?          @relation("VendorUser")
  marketplaceBuyer                    MarketplaceBuyer?           @relation("BuyerUser")
  marketplaceReviews                  MarketplaceReview[]         @relation("ReviewerUser")
  recordedTransactions                MarketplaceTransaction[]    @relation("TxnRecorder")
  briefPurchases                      BriefPurchase[]             @relation("UserBriefPurchases")
  investorMandate                     InvestorMandate?            @relation("UserInvestorMandate")
  hubPatients                         HubPatient[]                @relation("PractitionerHubPatients")
  hubInvoices                         Invoice[]                   @relation("PractitionerInvoices")
  insurersCreated                     Insurer[]                   @relation("InsurerCreator")
  remindersSent                       PaymentReminder[]           @relation("ReminderSender")
  verificationRequests                VerificationRequest[]       @relation("UserVerificationRequests")
  consentRecords                      ConsentRecord[]             @relation("UserConsentRecords")
  auditLogs                           AuditLog[]                  @relation("UserAuditLogs")
  accessRoleAssignments               UserAccessRole[]            @relation("UserAccessRoles")
  directPermissions                   UserPermission[]            @relation("UserDirectPermissions")
  clinicalRelationshipsAsPractitioner ClinicalRelationship[]      @relation("ClinicalPractitioner")
  clinicalRelationshipsAsPatient      ClinicalRelationship[]      @relation("ClinicalPatient")
  authTokens                          AuthToken[]                 @relation("UserAuthTokens")
  notificationEvents                  NotificationEvent[]         @relation("UserNotificationEvents")
  notificationPreference              NotificationPreference?
  uploadAssets                        UploadAsset[]               @relation("UserUploadAssets")
  billingSubscriptions                Subscription[]              @relation("UserSubscriptions")
  billingEntitlements                 Entitlement[]               @relation("UserEntitlements")
  paymentIntents                      PaymentIntent[]             @relation("UserPaymentIntents")
  providerCustomers                   ProviderCustomer[]          @relation("UserProviderCustomers")
  billingReceipts                     Receipt[]                   @relation("UserReceipts")
  jobsOwned                           Job[]                       @relation("JobEmployer")
  jobApplications                     JobApplication[]            @relation("JobApplicant")
  applicationStatusChanges            JobApplicationStatusEvent[] @relation("ApplicationStatusActor")
  dataSubjectRequests                 DataSubjectRequest[]        @relation("DataSubjectRequester")
  assignedDataSubjectRequests         DataSubjectRequest[]        @relation("DataSubjectAssignee")
  dataSubjectRequestEvents            DataSubjectRequestEvent[]   @relation("DataSubjectEventActor")
  securityIncidentsReported           SecurityIncident[]          @relation("SecurityIncidentReporter")
  securityIncidentsAssigned           SecurityIncident[]          @relation("SecurityIncidentAssignee")
  ndaAcceptances                      NdaAcceptance[]             @relation("NdaAcceptor")

  @@index([role])
  @@index([tier])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PractitionerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  medicalRegNumber String
  specialty        String
  consultationRate Int      @default(2500)
  hospital         String?
  bio              String?
  clinicId         String?
  affiliations     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Innovation {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation("InnovationOwner", fields: [ownerId], references: [id])
  title            String
  tagline          String?
  sector           String
  summary          String           @db.Text
  problem          String?          @db.Text
  solution         String?          @db.Text
  stage            InnovationStage  @default(IDEA)
  status           InnovationStatus @default(DRAFT)
  fundingGoal      Int              @default(0)
  fundingRaised    Int              @default(0)
  validationScore  Int              @default(0)
  credibilityScore Int              @default(0)
  verified         Boolean          @default(false)
  location         String?
  imageUrl         String?
  team             String?          @db.Text
  evidence         String?          @db.Text
  fundingUse       String?          @db.Text
  ipHash           String?
  ipTimestampedAt  DateTime?
  submittedAt      DateTime?

  // IP Protection & Self-Assessment (Innovation Hub IP Journey)
  ipProtectionLevel       String? // PRE_PATENT, PROVISIONAL_FILED, PATENT_GRANTED, TRADE_SECRET, OPEN_SOURCE
  patentRegNumber         String?
  patentJurisdiction      String?
  openSourceLicense       String?
  priorDisclosure         Boolean   @default(false)
  priorDisclosureDate     DateTime?
  thirdPartyDeps          Boolean   @default(false)
  thirdPartyDepsNote      String?   @db.Text
  revenueModel            String? // LICENSING, SAAS, ROYALTY, MANUFACTURING, OTHER
  impactStatement         String?   @db.Text // Greater Good / public health value
  selfAssessmentData      String?   @db.Text // JSON blob of full checklist answers
  selfAssessmentCompleted Boolean   @default(false)
  declarationSignedAt     DateTime?

  // Tier 2 Vault Content (protected behind NDA)
  technicalBlueprint   String? @db.Text // Detailed technical specs, schematics
  financialModelDetail String? @db.Text // Detailed financial projections, cap tables
  patentDocumentation  String? @db.Text // Unfiled drafts, provisional claims
  clinicalData         String? @db.Text // Clinical/field validation data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones          Milestone[]
  investments         Investment[]
  diligenceItems      DiligenceItem[]
  cashFlows           CashFlowEntry[]
  endorsements        Endorsement[]
  vaultAccessRequests VaultAccessRequest[]
  vaultDocuments      VaultDocument[]

  @@index([ownerId])
  @@index([status])
  @@index([sector])
}

model Milestone {
  id             String          @id @default(cuid())
  innovationId   String
  innovation     Innovation      @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  title          String
  description    String?         @db.Text
  targetAmount   Int             @default(0)
  releasedAmount Int             @default(0)
  dueDate        DateTime?
  status         MilestoneStatus @default(PENDING)
  progress       Int             @default(0)
  orderIndex     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([innovationId])
}

model Investment {
  id           String           @id @default(cuid())
  investorId   String
  investor     User             @relation("InvestorInvestments", fields: [investorId], references: [id])
  innovationId String
  innovation   Innovation       @relation(fields: [innovationId], references: [id])
  amount       Int              @default(0)
  status       InvestmentStatus @default(INTERESTED)
  committedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([investorId])
  @@index([innovationId])
}

model DiligenceItem {
  id           String          @id @default(cuid())
  innovationId String
  innovation   Innovation      @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  status       DiligenceStatus @default(PENDING)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([innovationId])
}

model CashFlowEntry {
  id           String       @id @default(cuid())
  innovationId String
  innovation   Innovation   @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  type         CashFlowType
  category     String
  amount       Int
  description  String?
  date         DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@index([innovationId])
}

model Endorsement {
  id           String     @id @default(cuid())
  innovationId String
  innovation   Innovation @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  endorserId   String
  endorser     User       @relation("UserEndorsements", fields: [endorserId], references: [id])
  comment      String?
  createdAt    DateTime   @default(now())

  @@index([innovationId])
}

enum GpsEntryType {
  FORMAL_ROLE
  COMMUNITY_INITIATIVE
  RESEARCH_POLICY
  VOLUNTEER
  TRADITIONAL_KNOWLEDGE
}

enum GpsEndorserType {
  SUPERVISOR
  COMMUNITY_ORG
  BENEFICIARY
  EXPERT
  PEER
  ACADEMIC
}

model GpsEntry {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("UserGpsEntries", fields: [userId], references: [id], onDelete: Cascade)
  title          String
  organization   String?
  entryType      GpsEntryType @default(FORMAL_ROLE)
  healthArea     String?
  geography      String?
  periodStart    String?
  periodEnd      String?
  gap            String       @db.Text
  rootCause      String?      @db.Text
  solution       String       @db.Text
  outcome        String       @db.Text
  lessonsLearned String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  endorsements       GpsEndorsement[]
  evidence           GpsEvidence[]
  challengeResponses ChallengeResponse[]

  @@index([userId])
}

enum ChallengeStatus {
  OPEN
  CLOSED
}

model ChallengeBrief {
  id           String          @id @default(cuid())
  authorId     String
  author       User            @relation("UserChallengeBriefs", fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  organization String?
  healthArea   String?
  geography    String?
  problem      String          @db.Text
  lookingFor   String          @db.Text
  deadline     String?
  status       ChallengeStatus @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  responses ChallengeResponse[]

  @@index([authorId])
  @@index([status])
}

model ChallengeResponse {
  id          String         @id @default(cuid())
  briefId     String
  brief       ChallengeBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  responderId String
  responder   User           @relation("UserChallengeResponses", fields: [responderId], references: [id], onDelete: Cascade)
  gpsEntryId  String?
  gpsEntry    GpsEntry?      @relation(fields: [gpsEntryId], references: [id], onDelete: SetNull)
  message     String         @db.Text
  createdAt   DateTime       @default(now())

  @@unique([briefId, responderId])
  @@index([briefId])
  @@index([responderId])
}

model GpsEvidence {
  id               String       @id @default(cuid())
  gpsEntryId       String
  gpsEntry         GpsEntry     @relation(fields: [gpsEntryId], references: [id], onDelete: Cascade)
  fileName         String
  cloudStoragePath String
  uploadAssetId    String?      @unique
  uploadAsset      UploadAsset? @relation("GpsEvidenceUpload", fields: [uploadAssetId], references: [id], onDelete: Restrict)
  contentType      String
  isPublic         Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([gpsEntryId])
}

model GpsEndorsement {
  id           String          @id @default(cuid())
  gpsEntryId   String
  gpsEntry     GpsEntry        @relation(fields: [gpsEntryId], references: [id], onDelete: Cascade)
  endorserId   String
  endorser     User            @relation("GpsEndorser", fields: [endorserId], references: [id])
  endorserType GpsEndorserType
  comment      String?         @db.Text
  createdAt    DateTime        @default(now())

  @@unique([gpsEntryId, endorserId])
  @@index([gpsEntryId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserLedger", fields: [userId], references: [id])
  date        DateTime @default(now())
  description String
  debit       Int      @default(0)
  credit      Int      @default(0)
  balance     Int      @default(0)
  category    String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Appointment {
  id             String            @id @default(cuid())
  practitionerId String
  practitioner   User              @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id])
  dateTime       DateTime
  type           AppointmentType   @default(CONSULTATION)
  status         AppointmentStatus @default(SCHEDULED)
  location       String?
  fee            Int               @default(0)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  billingRecord BillingRecord?

  @@index([practitionerId])
  @@index([patientId])
  @@index([dateTime])
  @@index([status])
}

model BillingRecord {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Int
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentStatus])
}

enum SideEffectSeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

model AdverseDrugReport {
  id               String             @id @default(cuid())
  reporterId       String?
  // Retention: safety reports are NEVER deleted. If the reporting member's account
  // is removed the report survives with the reporter link cleared.
  reporter         User?              @relation("UserDrugReports", fields: [reporterId], references: [id], onDelete: SetNull)
  drugName         String
  doseTaken        String
  sideEffects      String // type of side effects experienced
  severity         SideEffectSeverity @default(MODERATE)
  patientAge       Int
  patientGender    String
  patientWeight    Float? // required for children under 12
  isPregnant       Boolean            @default(false)
  otherMedication  String? // other medication currently in use
  onsetDaysAgo     Int? // how many days after starting the drug the reaction began
  durationDays     Int? // how many days the reaction lasted
  treatmentGiven   Boolean? // was any treatment given for the reaction
  treatmentDetails String? // what treatment was given
  province         String?
  country          String             @default("Kenya")
  description      String? // additional details
  archivedAt       DateTime? // stamped once the record passes the 5-year retention window; never deleted
  archiveRef       String? // cloud-storage key of the archive snapshot this record was written into
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([drugName])
  @@index([createdAt])
  @@index([archivedAt])
}

model ProductFeedback {
  id             String    @id @default(cuid())
  reviewerId     String?
  // Retention: product feedback is NEVER deleted. If the reviewer's account is
  // removed the feedback survives with the reviewer link cleared.
  reviewer       User?     @relation("UserProductFeedback", fields: [reviewerId], references: [id], onDelete: SetNull)
  productName    String
  productSize    String? // size of product
  isOnPlatform   Boolean   @default(false)
  innovationId   String? // links to marketplace product if on-platform
  rating         Int // 1-5 stars
  comment        String?
  isExpertReview Boolean   @default(false) // true if reviewer has PRACTITIONER role
  hasEvidence    Boolean   @default(false) // expert attached supporting evidence
  evidenceUrl    String? // link / reference to supporting evidence
  feedbackTier   String    @default("STAR") // STAR | STAR_COMMENT | EXPERT_COMMENT | EXPERT_EVIDENCE
  expertWeight   Float     @default(1.0) // computed tier weight: 1 / 1.5 / 3 / 5
  reporterEmail  String? // optional contact for acknowledgement
  province       String?
  country        String    @default("Kenya")
  archivedAt     DateTime? // stamped once the record passes the 5-year retention window; never deleted
  archiveRef     String? // cloud-storage key of the archive snapshot this record was written into
