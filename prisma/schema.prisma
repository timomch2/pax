// Directory of named payer entities (insurers, SHA, corporates, NGOs).
// isSystem=true entries are shared defaults; others are practitioner-added.
model Insurer {
  id           String          @id @default(cuid())
  name         String
  shortName    String?
  category     InsurerCategory @default(PRIVATE)
  contactPhone String?
  contactEmail String?
