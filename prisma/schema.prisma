  status      OperationalJobStatus @default(RUNNING)
  startedAt   DateTime             @default(now())
  heartbeatAt DateTime             @default(now())
  finishedAt  DateTime?
  processed   Int                  @default(0)
  failed      Int                  @default(0)
  details     Json?
  error       String?              @db.Text

  @@index([jobKey, startedAt])
  @@index([status, heartbeatAt])
}

model InvoiceSequence {
  id             String   @id @default(cuid())
  practitionerId String
  year           Int
  nextValue      Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@unique([practitionerId, year])
}

// Investor mandate — profiling for the Neural Matchmaking Pipeline.
// One per investor; drives AI compatibility scoring against innovations.
model InvestorMandate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserInvestorMandate", fields: [userId], references: [id], onDelete: Cascade)

  geographies   String[] @default([]) // e.g. "East Africa", "Sub-Saharan Africa"
  sectors       String[] @default([]) // health category pillars (from INNOVATION_SECTORS)
  stages        String[] @default([]) // InnovationStage values: IDEA|PROTOTYPE|PILOT|SCALING
  ticketMinUsd  Int      @default(0) // min ticket, USD
  ticketMaxUsd  Int      @default(0) // max ticket, USD (0 = no cap)
  notes         String?  @db.Text // free-text thesis / additional preferences
  notifyOnMatch Boolean  @default(true) // send deal alerts on new high-scoring matches
  active        Boolean  @default(true)

  // Ethical Investment Manifesto gate — must be accepted before accessing deal room
  ethicalManifestoAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model DebateContribution {
  id       String @id @default(cuid())
  debateId String
  debate   Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("DebateContributionAuthor", fields: [authorId], references: [id])

  kind                  ContributionKind @default(SHORT_REVIEW)
  body                  String           @db.Text
  dimension             String? // one of the 6 evaluation dimensions
  feasibilityScore      Int? // 1-5 practicality rating
