  evidenceUrl           String? // link to supporting data

  isDevilsAdvocate Boolean @default(false)
  isExpert         Boolean @default(false) // tier snapshot for the Expert badge
  aiGenerated      Boolean @default(false) // AI-drafted (e.g. devil's advocate)

  moderationStatus       ModerationStatus @default(OK)
  moderationReason       String?          @db.Text // AI's flag reason for the human queue
  moderationReviewedById String?
  moderationReviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  upvotes ContributionUpvote[]

  @@index([debateId])
  @@index([authorId])
  @@index([moderationStatus])
}

// Quick Reaction — a member's rapid stance on a debate (one per debate).
