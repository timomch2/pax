// A single payer line on an invoice (the split).
model InvoicePayer {
  id           String         @id @default(cuid())
  invoiceId    String
  invoice      Invoice        @relation("InvoicePayers", fields: [invoiceId], references: [id], onDelete: Cascade)
  payerType    PayerType      @default(PATIENT)
  payerName    String
  insurerId    String?
  insurer      Insurer?       @relation("InsurerPayerLines", fields: [insurerId], references: [id], onDelete: SetNull)
  amount       Int            @default(0)
  amountPaid   Int            @default(0)
  method       PaymentMethod?
  status       PaymentStatus  @default(PENDING)
  dueDate      DateTime?
  paidAt       DateTime?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reminders PaymentReminder[] @relation("PayerReminders")

  @@index([invoiceId])
  @@index([status])
  @@index([dueDate])
}

// A logged payment reminder sent to a debtor (payer line).
model PaymentReminder {
  id             String          @id @default(cuid())
  invoicePayerId String
  invoicePayer   InvoicePayer    @relation("PayerReminders", fields: [invoicePayerId], references: [id], onDelete: Cascade)
  sentById       String
  sentBy         User            @relation("ReminderSender", fields: [sentById], references: [id], onDelete: Cascade)
  channel        ReminderChannel @default(IN_APP)
  message        String          @db.Text
  isAutomated    Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@index([invoicePayerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// KNOWLEDGE EXCHANGE — Debate Hub (qualitative evidence engine)
// ---------------------------------------------------------------------------

enum DebateType {
  POLICY_PRACTICE // Type A — Policy vs Practice case studies
  RESEARCH_FEASIBILITY // Type B — Research feasibility & implementation audits
  INNOVATION_PILOT // Type C — Innovation pilot reviews & market-gap discovery
}

enum DebateStatus {
  PROPOSED
  UNDER_REVIEW
  OPEN
  CLOSING_SOON
  CLOSED
  IN_SYNTHESIS
  PUBLISHED
}

// 3-tier feedback engine: Quick Reaction (DebateStance) escalates to these two written kinds.
enum ContributionKind {
  SHORT_REVIEW // brief contextual commentary / regional nuance (Tier 1/2)
  EXPERT_OPINION // in-depth Tier 3 technical critique / peer review
}

// Quick Reaction tags — a member's rapid position on a debate.
enum StanceType {
  AGREE
  DISAGREE
  PARTLY_AGREE
  INSUFFICIENT_EVIDENCE
  RELEVANT_MY_SETTING
  NOT_FEASIBLE_MY_SETTING
}

// AI flags; a human decides. AI never sets REMOVED.
enum ModerationStatus {
  OK // visible, no concern
  FLAGGED // AI raised a concern — still visible, awaiting human review
  REMOVED // hidden — only ever set by a human moderator
}

model Debate {
  id          String       @id @default(cuid())
  initiatorId String
  initiator   User         @relation("DebateInitiator", fields: [initiatorId], references: [id])
  type        DebateType
  status      DebateStatus @default(OPEN)

  title          String
  motion         String  @db.Text // central question / motion
  healthDomain   String? // Health Security / UHC / Supply Chain / Maternal Health / etc
  geographyFocus String? // Global / Regional / Country-specific label

  // Anchor (optional — a debate can start from a question, not a 2-pager)
  anchorType             String? // policy | paper | innovation | field-challenge
  anchorReference        String? @db.Text // link or citation
  standardRecommendation String? @db.Text // quoted official objective / recommendation

  background       String? @db.Text // short framing note
  problemStatement String  @db.Text // ground-truth gap between requirement and reality

  // Qualitative prompts shown to the community (editable per debate)
  promptGroundTruth String? @db.Text
  promptAdaptation  String? @db.Text
  promptFeasibility String? @db.Text

  devilsAdvocateId String?
  devilsAdvocate   User?   @relation("DebateDevilsAdvocate", fields: [devilsAdvocateId], references: [id])

  closesAt DateTime?
  featured Boolean   @default(false)

  // Cross-links to PAX ecosystem (optional)
  relatedInnovationId String?
  relatedListingId    String?

  // Synthesis (Phase 2 wiring — AI drafts, human approves)
  consensusAbstract    String?   @db.Text // free teaser shown to all members
  consensusBrief       String?   @db.Text
  consensusPublishedAt DateTime?
  feasibilityConsensus Float? // rollup of feasibility scores (1-5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions  DebateContribution[]
  stances        DebateStance[]
  briefPurchases BriefPurchase[]      @relation("DebateBriefPurchases")

  @@index([type])
  @@index([status])
  @@index([initiatorId])
  @@index([featured])
}

// One-time purchase unlocking a detailed consensus brief download.
// First-party PAX revenue (not brokered) — abstract is free, full brief is paid.
model BriefPurchase {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("UserBriefPurchases", fields: [userId], references: [id], onDelete: Cascade)
  debateId String
  debate   Debate @relation("DebateBriefPurchases", fields: [debateId], references: [id], onDelete: Cascade)

  amountCents       Int            @default(99) // price at purchase time, in cents
  currency          String         @default("USD")
  status            String         @default("PENDING") // PENDING | PAID | FAILED
  provider          String         @default("paystack")
  providerReference String? // Paystack transaction reference
  paymentIntentId   String?        @unique
  paymentIntent     PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, debateId])
  @@index([debateId])
  @@index([status])
  @@index([providerReference])
}

// First-party billing only. Marketplace vendor/buyer transactions never use these models.
model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?        @db.Text
  active        Boolean        @default(false)
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prices        PlanPrice[]
  subscriptions Subscription[]

  @@index([active])
}

model PlanPrice {
