  innovation          Innovation     @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  requesterId         String
  requester           User           @relation("VaultRequester", fields: [requesterId], references: [id])
  status              String         @default("REQUESTED") // REQUESTED, NDA_SIGNED, APPROVED, DENIED, REVOKED
  ndaSignedAt         DateTime?
  ndaIpAddress        String?
  ndaSnapshot         String?        @db.Text // JSON snapshot of NDA metadata at time of signing
  innovatorApprovedAt DateTime?
  innovatorDeniedAt   DateTime?
  denialReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  ndaAcceptance       NdaAcceptance?

  @@unique([innovationId, requesterId])
  @@index([innovationId])
  @@index([requesterId])
  @@index([status])
}

model NdaTemplate {
  id          String          @id @default(cuid())
  slug        String
  version     Int
  title       String
  body        String          @db.Text
  contentHash String
  active      Boolean         @default(false)
  effectiveAt DateTime
  createdAt   DateTime        @default(now())
  acceptances NdaAcceptance[]

  @@unique([slug, version])
  @@index([slug, active, effectiveAt])
}

model NdaAcceptance {
  id              String             @id @default(cuid())
  accessRequestId String             @unique
  accessRequest   VaultAccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Restrict)
  templateId      String
  template        NdaTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  acceptorId      String
  acceptor        User               @relation("NdaAcceptor", fields: [acceptorId], references: [id], onDelete: Restrict)
  typedName       String
  accountEmail    String
  organization    String?
  innovationId    String
  contentHash     String
  acceptedAt      DateTime           @default(now())
  ipAddress       String?
  userAgent       String?            @db.Text

  @@index([acceptorId, acceptedAt])
  @@index([innovationId])
}

model VaultDocument {
  id           String      @id @default(cuid())
  innovationId String
  innovation   Innovation  @relation(fields: [innovationId], references: [id], onDelete: Restrict)
  ownerId      String
  title        String
  description  String?     @db.Text
  assetId      String      @unique
  asset        UploadAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([innovationId, active])
  @@index([ownerId])
}

// ──────────────────────────────────────────────────────────────────────────
// MARKETPLACE
// ──────────────────────────────────────────────────────────────────────────

enum MarketplacePillar {
  DIGITAL_TOOLS_IP
  HEALTH_SECURITY_ANALYTICS
  LAB_RADIOLOGICAL_HARDWARE
  PHARMA_DIRECTORY
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  FROZEN
}

enum MarketplaceListingType {
  PRODUCT
  SERVICE
  SOFTWARE
  FACILITY_PROFILE
  DIRECTORY_PROFILE
}

enum BuyerEntityType {
  PUBLIC_HEALTH_AGENCY
  HOSPITAL_CLINIC
  ACCREDITED_LAB
  NGO_DONOR
  RESEARCH_CENTER
}

model MarketplaceVendor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("VendorUser", fields: [userId], references: [id], onDelete: Cascade)

  // Section 1: Business ID
  corporateName      String
  tradingName        String?
  country            String
  registrationNumber String
  taxId              String?
  headOfficeAddress  String            @db.Text
  city               String?
  postalCode         String?
  contactPerson      String
  contactEmail       String
  contactPhone       String
  primaryPillar      MarketplacePillar

  // Section 4: Legal Initials (clickwrap)
  acceptedNoDirectDrugSales     Boolean @default(false)
  acceptedPureIntermediary      Boolean @default(false)
  acceptedB2BTestKitRestriction Boolean @default(false)
  acceptedFullIndemnification   Boolean @default(false)
  acceptedAIModeration          Boolean @default(false)

  // Status
  status            VendorStatus @default(PENDING)
  adminNotes        String?      @db.Text
  approvedAt        DateTime?
  frozenAt          DateTime?
  // Annual licence re-verification (365-day cycle). Set on approval; auto-freeze when passed.
  licenseExpiryDate DateTime?

  documents    VendorDocument[]
  listings     MarketplaceListing[]
  transactions MarketplaceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([primaryPillar])
}

model VendorDocument {
  id               String            @id @default(cuid())
  vendorId         String
  vendor           MarketplaceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  docType          String // NATIONAL_LICENSE, ORIGIN_PREQUALIFICATION, LOCAL_AUTHORIZATION, DEALER_LETTER, RADIATION_CLEARANCE, FACILITY_ACCREDITATION
  fileName         String
  cloudStoragePath String
  uploadAssetId    String?           @unique
  uploadAsset      UploadAsset?      @relation("VendorDocumentUpload", fields: [uploadAssetId], references: [id], onDelete: Restrict)
  contentType      String            @default("application/pdf")
  expiryDate       DateTime?
  uploadedAt       DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model MarketplaceListing {
  id            String                 @id @default(cuid())
  vendorId      String
  vendor        MarketplaceVendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pillar        MarketplacePillar
  listingType   MarketplaceListingType
  title         String
  description   String                 @db.Text
  features      String?                @db.Text // JSON array of feature bullets
  catalogNumber String?
  manufacturer  String?
  regionFocus   String?
  externalUrl   String? // For pharmacy directory link-out
  imageUrls     String?                @db.Text // JSON array of image URLs

  isPublished        Boolean   @default(false)
  isPaxCertified     Boolean   @default(false)
  paxCertifiedAt     DateTime?
  paxCertifiedReason String? // "Funded via investor", "Debate-originated", "PAX-approved"

  priceDisplay String? // e.g. "KSh 50,000" or "Contact vendor"

  // AI content moderation (FLAG-only — never auto-hides; human admin decides)
  moderationStatus     String  @default("OK") // OK | FLAGGED
  moderationReason     String? @db.Text
  moderationCategories String? // JSON array of category strings

  reviews      MarketplaceReview[]
  transactions MarketplaceTransaction[]
  avgRating    Float?
  reviewCount  Int                      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([pillar])
  @@index([isPublished])
  @@index([isPaxCertified])
  @@index([moderationStatus])
}

model MarketplaceTransaction {
  id           String             @id @default(cuid())
  listingId    String
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       MarketplaceVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User               @relation("TxnRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  buyerName    String
  amount       Float
  currency     String             @default("KSh")
  feePercent   Float              @default(5)
  feeAmount    Float
  netToVendor  Float
  status       String             @default("RECORDED") // RECORDED | SETTLED (display only — PAX processes no payments)
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([vendorId])
  @@index([listingId])
  @@index([recordedById])
}

model MarketplaceReview {
  id         String             @id @default(cuid())
  listingId  String
  listing    MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User               @relation("ReviewerUser", fields: [reviewerId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, reviewerId])
  @@index([listingId])
}

model MarketplaceBuyer {
  id                         String          @id @default(cuid())
  userId                     String          @unique
  user                       User            @relation("BuyerUser", fields: [userId], references: [id], onDelete: Cascade)
  institutionName            String
  entityType                 BuyerEntityType
  jurisdiction               String
  country                    String?
  physicalAddress            String?         @db.Text
  city                       String?
  postalCode                 String?
  phone                      String?
  procurementOfficer         String
  officerTitle               String?
  officerEmail               String
  accreditationPath          String? // cloud storage path
  accreditationUploadAssetId String?         @unique
  accreditationUploadAsset   UploadAsset?    @relation("BuyerAccreditationUpload", fields: [accreditationUploadAssetId], references: [id], onDelete: Restrict)
  acceptedDirectProcurement  Boolean         @default(false)
  status                     String          @default("PENDING") // PENDING, VERIFIED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Verification ladder requests (Identity / Expert level)
model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)

  // Which level is being requested
  requestedLevel VerificationLevel // IDENTITY_VERIFIED or EXPERT_VERIFIED

  // Documents submitted for this request
  documents VerificationDocument[]

  // For Expert: peer vouchers (names/emails of 2+ peers)
  peerVouchers String? @db.Text // JSON array of {name, email, relationship}

  status     VerificationRequestStatus @default(PENDING)
  adminNotes String?                   @db.Text
  reviewedAt DateTime?
  reviewedBy String? // admin user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestedLevel])
}

model VerificationDocument {
  id               String              @id @default(cuid())
  requestId        String
  request          VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  docType          String // NATIONAL_ID, PASSPORT, PROFESSIONAL_LICENSE, BOARD_CERTIFICATE, PEER_LETTER, OTHER
  fileName         String
  cloudStoragePath String
  uploadAssetId    String?             @unique
  uploadAsset      UploadAsset?        @relation("VerificationDocumentUpload", fields: [uploadAssetId], references: [id], onDelete: Restrict)
  contentType      String              @default("application/pdf")

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Data protection: append-only consent ledger and audit trail
// Kenya Data Protection Act 2019 s.32 (proof of consent) and s.25 (accountability)
// ---------------------------------------------------------------------------

enum ConsentType {
  ACCOUNT_TERMS
  PRIVACY_POLICY
  HEALTH_DATA_PROCESSING
  MARKETING
  CROSS_BORDER_TRANSFER
}

model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("UserConsentRecords", fields: [userId], references: [id], onDelete: Cascade)
  consentType   ConsentType
  granted       Boolean     @default(true)
  policyVersion String?
  termsVersion  String?
  grantedAt     DateTime    @default(now())
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([userId, consentType])
  @@index([grantedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  outcome    String   @default("SUCCESS")
  ipAddress  String?
  userAgent  String?  @db.Text
  context    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Granular authorization and clinical relationship boundaries
// ---------------------------------------------------------------------------

model AccessRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments UserAccessRole[]

  @@index([active])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[]

  @@index([resource, action])
}

model RolePermission {
  id           String      @id @default(cuid())
  accessRoleId String
  accessRole   AccessRole  @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        AccessScope @default(OWN)
  createdAt    DateTime    @default(now())

  @@unique([accessRoleId, permissionId])
  @@index([permissionId])
}

model UserAccessRole {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation("UserAccessRoles", fields: [userId], references: [id], onDelete: Cascade)
  accessRoleId   String
  accessRole     AccessRole  @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  scope          AccessScope @default(OWN)
  organizationId String?
  assignedById   String?
  startsAt       DateTime    @default(now())
  endsAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([userId, accessRoleId])
  @@index([accessRoleId])
  @@index([organizationId])
  @@index([endsAt])
}

model UserPermission {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("UserDirectPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect         PermissionEffect @default(ALLOW)
  scope          AccessScope      @default(OWN)
  organizationId String?
  assignedById   String?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@index([expiresAt])
}

model ClinicalRelationship {
  id              String                     @id @default(cuid())
  practitionerId  String
  practitioner    User                       @relation("ClinicalPractitioner", fields: [practitionerId], references: [id], onDelete: Restrict)
  patientId       String
  patient         User                       @relation("ClinicalPatient", fields: [patientId], references: [id], onDelete: Restrict)
  status          ClinicalRelationshipStatus @default(ACTIVE)
  consentedAt     DateTime?
  establishedById String?
  endedAt         DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([practitionerId, patientId])
  @@index([patientId, status])
  @@index([practitionerId, status])
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserAuthTokens", fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  key          String    @id
  windowStart  DateTime
  count        Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model NotificationTemplate {
  id                  String              @id @default(cuid())
  slug                String
  channel             NotificationChannel
  locale              String              @default("en")
  version             Int                 @default(1)
  subject             String?
  body                String              @db.Text
  actionLabel         String?
  actionUrl           String?
  requiredVariables   String[]            @default([])
  enabled             Boolean             @default(true)
  sensitiveAllowed    Boolean             @default(false)
  nonDisableable      Boolean             @default(false)
  providerTemplateKey String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([slug, channel, locale, version])
  @@index([slug, channel, locale, enabled])
}

model NotificationEvent {
  id              String                  @id @default(cuid())
  userId          String?
  user            User?                   @relation("UserNotificationEvents", fields: [userId], references: [id], onDelete: SetNull)
  templateSlug    String
  templateVersion Int
  locale          String                  @default("en")
  variables       Json
  idempotencyKey  String                  @unique
  priority        Int                     @default(0)
  status          NotificationEventStatus @default(PENDING)
  attempts        Int                     @default(0)
  maxAttempts     Int                     @default(5)
  availableAt     DateTime                @default(now())
  lockedAt        DateTime?
  processedAt     DateTime?
  lastError       String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  deliveries NotificationDelivery[]

  @@index([status, availableAt, priority])
  @@index([userId, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  event             NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  recipient         String
  provider          String?
  providerMessageId String?
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  lastError         String?                    @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  deadLetteredAt    DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([eventId, channel, recipient])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  marketingEmail  Boolean  @default(false)
  marketingSms    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UploadAsset {
  id                  String        @id @default(cuid())
  ownerId             String
  owner               User          @relation("UserUploadAssets", fields: [ownerId], references: [id], onDelete: Restrict)
  purpose             UploadPurpose
  status              UploadStatus  @default(PENDING_UPLOAD)
  originalFileName    String
  objectKey           String        @unique
  expectedContentType String
  expectedSize        Int
  expectedChecksum    String?
  actualContentType   String?
  actualSize          Int?
  actualChecksum      String?
  objectEtag          String?
  scanProvider        String?
  scanReference       String?
  scanResult          String?       @db.Text
  completedAt         DateTime?
  scannedAt           DateTime?
  retainedUntil       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  accessLogs           UploadAssetAccessLog[]
  gpsEvidence          GpsEvidence?           @relation("GpsEvidenceUpload")
  vendorDocument       VendorDocument?        @relation("VendorDocumentUpload")
  verificationDocument VerificationDocument?  @relation("VerificationDocumentUpload")
  buyerAccreditation   MarketplaceBuyer?      @relation("BuyerAccreditationUpload")
  jobApplications      JobApplication[]
  vaultDocument        VaultDocument?

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([retainedUntil])
}

model UploadAssetAccessLog {
  id        String      @id @default(cuid())
  assetId   String
  asset     UploadAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actorId   String?
  action    String
  outcome   String      @default("SUCCESS")
  ipAddress String?
  userAgent String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([assetId, createdAt])
  @@index([actorId, createdAt])
}
