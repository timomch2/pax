// A bill raised by a practitioner. Total can be SPLIT across multiple payers.
model Invoice {
  id             String        @id @default(cuid())
  practitionerId String
  practitioner   User          @relation("PractitionerInvoices", fields: [practitionerId], references: [id], onDelete: Cascade)
